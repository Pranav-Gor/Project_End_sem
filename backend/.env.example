# MongoDB (database name auction — matches Compass "auction" DB)
MONGODB_URI=mongodb://localhost:27017/auction

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PASETO v4 public tokens: Ed25519 PKCS8 private key PEM (optional).
# If unset, the server creates backend/.paseto-ed25519.pem on first run.
# One-line in .env: PASETO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Generate a key file: node scripts/generate-paseto-key.js
# PASETO_PRIVATE_KEY=

# SMTP — required for seller approval/rejection emails to reach applicants
# Gmail: enable 2-Step Verification, then create an "App password" at
#   https://myaccount.google.com/apppasswords
# Use the app password as SMTP_PASS (not your normal Gmail password).
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Auctus <youraccount@gmail.com>"

# GSTIN verification provider key (used before seller KYC submission is saved)
GSTINCHECK_API_KEY=your_gstincheck_api_key

# Razorpay — wallet top-ups (Key ID + secret from Dashboard → API Keys; webhook secret from Webhooks)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
# Required for POST /api/payments/razorpay-webhook (signing secret from the webhook you create in Dashboard)
RAZORPAY_WEBHOOK_SECRET=

# Supabase Storage Integration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=sb_secret_6_Fds56SkfhjWMFBPEQG1Q_WHzI8E4_
